# Copy to .env (chmod 600) and fill in.
HUB_BIND_IP=<tailnet-ip-of-this-server>
HUB_HOSTNAME=<public-hostname>
# true only after the first superuser exists
# must be exactly true or false
HUB_PUBLIC=false
# Password login only while HUB_PUBLIC=false (tailnet-only), until OIDC is set up
DISABLE_PASSWORD_AUTH=true
HUB_URL=http://<tailnet-ip-of-this-server>:8090
# From the hub: Add system -> shows KEY and TOKEN (needed for beszel-agent only)
KEY=
TOKEN=
# Shared secret for fuekw-watch -> volumen (openssl rand -hex 32)
VOLUMEN_TOKEN=
